# ==============================================================================
# NeuroClass Environment Configuration Template
# Copy this file to '.env' and adjust values for your local or cloud setup
# ==============================================================================

# Application Branding
VITE_APP_TITLE="NeuroClass: Clinical Brain Tumor CADx"
VITE_APP_DESCRIPTION="Deep Learning-Powered Brain Tumor MRI Classification & Grad-CAM Visual Explainability"

# API & Backend Inference Server URL (Optional: defaults to client-side engine if unset)
# VITE_API_URL="http://localhost:3001"

# DICOM Calibration
VITE_CALIBRATION_MM_PER_PIXEL=0.8

# Backend Server Runtime (for server/api.ts)
PORT=3000
NODE_ENV=production
