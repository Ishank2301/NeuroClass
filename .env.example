# ==============================================================================
# NeuroClass CADx Platform: Environment Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this template to create your local environment file:
#    cp .env.example .env
# 2. Never commit actual secret keys or credentials to public Git repositories.
# 3. For Firebase configuration, also copy 'firebase-applet-config.example.json'
#    to 'firebase-applet-config.json'.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER RUNTIME & SECURITY
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=production

# ------------------------------------------------------------------------------
# 2. GOOGLE GEMINI AI API (Medical Consultation & Multimodal Diagnostics)
# ------------------------------------------------------------------------------
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 3. GOOGLE CLOUD SQL (PostgreSQL Database Engine)
# ------------------------------------------------------------------------------
# Connection parameters for PostgreSQL persistent storage (Users, Sessions, Scans)
SQL_HOST=127.0.0.1
SQL_DB_NAME=neuroclass
SQL_USER=neuroclass_user
SQL_PASSWORD=your_secure_db_password_here
SQL_ADMIN_USER=postgres
SQL_ADMIN_PASSWORD=your_admin_db_password_here

# ------------------------------------------------------------------------------
# 4. FIREBASE & GOOGLE OAUTH CLIENT CONFIGURATION
# ------------------------------------------------------------------------------
# Values from your Google Cloud Console / Firebase Project Settings
VITE_FIREBASE_API_KEY=AIzaSy_YOUR_API_KEY_HERE
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
VITE_FIREBASE_OAUTH_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# 5. PACS WORKSTATION & DICOM CALIBRATION
# ------------------------------------------------------------------------------
VITE_APP_TITLE="NeuroClass: Clinical Brain Tumor CADx"
VITE_APP_DESCRIPTION="Deep Learning-Powered Brain Tumor MRI Classification & Grad-CAM Visual Explainability"
VITE_CALIBRATION_MM_PER_PIXEL=0.8
